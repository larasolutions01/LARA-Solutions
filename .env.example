# ─────────────────────────────────────────────────────────────
# LARA Solutions website — environment variables
# Copy to .env.local for development. NEVER commit real secrets.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser — only put
# public, non-secret values there.
# ─────────────────────────────────────────────────────────────

# Canonical site URL (used for SEO, sitemap, Open Graph). Production builds
# default to https://larasolutions.co.in when this is empty.
NEXT_PUBLIC_SITE_URL=https://larasolutions.co.in
# Set to "true" on staging to block search engines
NEXT_PUBLIC_NOINDEX=
NEXT_PUBLIC_LEGAL_NAME=LARA Solutions

# ── Public contact details (leave empty to hide) ──────────────
NEXT_PUBLIC_CONTACT_EMAIL=larasolutions01@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=
# Digits only, international format, e.g. 15551234567
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Calendly or other scheduler link, e.g. https://calendly.com/your-team/discovery
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# ── Analytics / Search Console ────────────────────────────────
# Use GTM *or* GA4 (GTM takes precedence if both are set)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools meta verification code (msvalidate.01)
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ── Search & AI discovery (see docs/SEO-AUDIT.md) ─────────────
# Comma-separated regions you genuinely serve, e.g. "United Kingdom,India".
# Leave empty unless confirmed — it is published in structured data.
NEXT_PUBLIC_AREA_SERVED=
# IndexNow key (8–128 letters/digits/dashes). Served at /indexnow-key.txt;
# submit changed URLs after deploys with `npm run indexnow`.
INDEXNOW_KEY=
# AI search/retrieval agents (OAI-SearchBot, Claude-SearchBot, PerplexityBot…)
# allow | block — default allow
AI_SEARCH_CRAWLERS=allow
# AI training crawlers (GPTBot, ClaudeBot, Google-Extended, CCBot…)
# allow | block — owner decision (8 Nov 2026): allow
AI_TRAINING_CRAWLERS=allow

# ── Lead storage: Supabase (server-only secrets) ──────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_LEADS_TABLE=leads

# ── Lead notifications: Resend email (server-only) ────────────
RESEND_API_KEY=
# Comma-separated list of team inboxes that receive new-lead alerts
LEAD_NOTIFICATION_EMAIL=larasolutions01@gmail.com
# Must be a sender on a domain verified in Resend
EMAIL_FROM="LARA Solutions Website <website@larasolutions.co.in>"

# ── CRM / automation webhook (server-only) ────────────────────
# e.g. HubSpot workflow, Zapier/Make/n8n webhook, or your own endpoint
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ── Spam protection: Cloudflare Turnstile (optional) ──────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Local file store (development default; opt-in elsewhere) ─
LEADS_FILE_STORE=
LEADS_FILE_DIR=.data

# ── Secure admin area (/admin — lead inbox) ───────────────────
# Leave empty to disable the admin area entirely.
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=

# ── AI (Google Gemini) — used by everything AI on the site ────
# One server-only key powers LARA AI Tools (/ai-tools) and the website
# assistant. Get it at https://aistudio.google.com/apikey (free tier: no card).
# Leave empty: the tools show "being set up" and the assistant uses its FAQ.
GEMINI_API_KEY=
# Optional overrides (defaults shown)
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: MINIMAL | LOW | MEDIUM | HIGH (model default when empty)
GEMINI_THINKING_LEVEL=
# Optional: Cloudflare AI Gateway URL ending in /google-ai-studio/v1beta/models
GEMINI_BASE_URL=
# Optional: token for an authenticated Cloudflare AI Gateway (server-only)
CF_AIG_TOKEN=
# Fair use + cost guard (per server instance; resets at midnight IST)
AI_TOOLS_DAILY_LIMIT=300
AI_TOOLS_DAILY_BUDGET_USD=1
AI_TOOLS_IP_DAILY_LIMIT=30

# ── Website assistant (chat bubble) ───────────────────────────
# Off unless set to "true" (switched off for now). Also opens /api/assistant
# and /api/assistant-lead.
NEXT_PUBLIC_ENABLE_ASSISTANT=

# When the assistant is on and GEMINI_API_KEY (above) is set, it answers with
# Gemini, grounded only on approved FAQ/service content, and shares the daily
# caps above. Without a key it uses the rule-based FAQ matcher.
